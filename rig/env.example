# Settings for the test rig under rig/ and tests/e2e. Everything has a default that matches the author's
# machine; export any of these before running rig/*.sh or tests/e2e/run_e2e.py to use another layout.
# The rig is a development tool. It is not part of the released plugin (release/export.sh leaves it out).

# Hermes checkout whose .venv runs the gateway and the tests (main, or v0.23.0 for the compatibility run)
HKO_HERMES_DIR=/home/asuran/hko-rig/hermes-agent
# HERMES_HOME of the rig profile (config.yaml, .env mode 600, plugin store). Use a different one per checkout.
HKO_RIG_HOME=/home/asuran/hko-rig/hermes-home
# Pid file and logs of the rig gateway
HKO_RIG_RUN=/home/asuran/hko-rig/run
# Where Kestra (inside Docker) can reach the Hermes webhook: the Docker network gateway address of the host.
HKO_WEBHOOK_HOST=10.250.90.1
HKO_WEBHOOK_PORT=28644
# Kestra credentials and the shared webhook token are read from /home/asuran/hko-rig/secrets/kestra.env
# (KESTRA_URL, KESTRA_USERNAME, KESTRA_PASSWORD, KESTRA_TENANT, HKO_WEBHOOK_TOKEN). Never commit that file.
# Only one gateway may own the webhook port at a time: rig/down.sh the other checkout first.
